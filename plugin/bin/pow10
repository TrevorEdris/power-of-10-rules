#!/usr/bin/env python3
"""pow10 CLI wrapper.

Adds the bundled plugin/ directory to sys.path so the pow10 package can be
imported without installation, then dispatches to pow10.cli.main().
"""

import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
PLUGIN_ROOT = os.path.dirname(HERE)
if PLUGIN_ROOT not in sys.path:
    sys.path.insert(0, PLUGIN_ROOT)

from pow10.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
